# Copy this file to secrets.yaml (which is gitignored) and fill in the values.

home_ssid: "your-home-wifi"
home_password: "your-home-password"

# Optional second SSID for studio / venue use; uncomment in cdj1000.yaml if used.
# studio_ssid: "studio-wifi"
# studio_password: "studio-password"

# 32-byte base64 key — generate with: openssl rand -base64 32
api_key: "base64-encoded-32-byte-key-here"

# OTA password — anything you'll remember
ota_password: "set-this-to-something-strong"
